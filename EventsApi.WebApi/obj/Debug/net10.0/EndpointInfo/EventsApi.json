{
  "openapi": "3.0.4",
  "info": {
    "title": "EventsApi",
    "version": "1.0"
  },
  "paths": {
    "/Bookings/{bookingId}": {
      "get": {
        "tags": [
          "АПИ для бронирования"
        ],
        "summary": "Информация по бронированию",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoBookingDTO"
                }
              }
            }
          }
        }
      }
    },
    "/Events/{eventId}/book": {
      "post": {
        "tags": [
          "АПИ для бронирования"
        ],
        "summary": "Метод для создания бронирования",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/Events": {
      "get": {
        "tags": [
          "АПИ для событий"
        ],
        "summary": "Метод возвращает список мероприятий с пагинацией",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "Название события",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Дата начала события",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Дата завершения события",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Страница, которую необходимо вернуть",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Количество элементов на странице",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "АПИ для событий"
        ],
        "summary": "Метод создает мероприятие",
        "requestBody": {
          "description": "Новое мероприятие",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/Events/{eventId}": {
      "get": {
        "tags": [
          "АПИ для событий"
        ],
        "summary": "Метод возвращает мероприятие по идентификатору из списка",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "description": "Параметр идентификатор мероприятия",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventInfoDTO"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "АПИ для событий"
        ],
        "summary": "Метод обновления даных мероприятия",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "description": "идентификатор мероприятия",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "данные для обновления",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "АПИ для событий"
        ],
        "summary": "Метод удаляет мероприятие по идентификатору из списка",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "description": "Параметр идентификатор мероприятия",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEventDTO": {
        "required": [
          "endAt",
          "startAt",
          "title",
          "totalSeats"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 1,
            "type": "string",
            "description": "Название мероприятия"
          },
          "description": {
            "type": "string",
            "description": "Описание мероприятия",
            "nullable": true
          },
          "startAt": {
            "type": "string",
            "description": "Дата начала мероприятия",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "description": "Дата окончания мероприятия",
            "format": "date-time"
          },
          "totalSeats": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "description": "общее количество мест на событии",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Модель данных для создания мероприятия"
      },
      "EventInfoDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор мероприятия",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Название мероприятия",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Описание",
            "nullable": true
          },
          "startAt": {
            "type": "string",
            "description": "Дата начала",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "description": "Дата окончания",
            "format": "date-time"
          },
          "totalSeats": {
            "type": "integer",
            "description": "Общее количество мест на событии",
            "format": "int32"
          },
          "availableSeats": {
            "type": "integer",
            "description": "Текущее количество свободных мест",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Модель для отображения мероприятия"
      },
      "InfoBookingDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор бронирования",
            "format": "uuid"
          },
          "eventID": {
            "type": "string",
            "description": "Идентификатор события по которому создано бронирование",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "Статус бронирования",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "дата и время создания брони",
            "format": "date-time"
          },
          "processedAt": {
            "type": "string",
            "description": "дата и время создания брони",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Модель DTO для отображения бронирования при запросе"
      },
      "PaginatedResult": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventInfoDTO"
            },
            "description": "список мероприятий",
            "nullable": true
          },
          "page": {
            "type": "integer",
            "description": "номер текущей страницы",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "количество мероприятий на текущей странице",
            "format": "int32"
          },
          "totalItems": {
            "type": "integer",
            "description": "общее количество мероприятий",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Модель ответа со списком мероприятий"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "UpdateEventDTO": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Название мероприятия",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Описание мероприятия",
            "nullable": true
          },
          "startAt": {
            "type": "string",
            "description": "Дата начала мероприятия",
            "format": "date-time",
            "nullable": true
          },
          "endAt": {
            "type": "string",
            "description": "Дата окончания мероприятия",
            "format": "date-time",
            "nullable": true
          },
          "totalSeats": {
            "type": "integer",
            "description": "Общее количество мест на событии",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Модель данных для создания мероприятия"
      }
    }
  },
  "tags": [
    {
      "name": "АПИ для бронирования"
    },
    {
      "name": "АПИ для событий"
    }
  ]
}